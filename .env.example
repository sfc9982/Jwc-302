# 监听地址，建议通过反向代理暴露 80/443
LISTEN_ADDR=127.0.0.1:8080

# IP 白名单文件
IPRANGE_FILE=iprange.txt

# 重定向目标基地址（注意末尾斜杠）
INTERNAL_URL=https://internal.example.edu/jsxsd/
EXTERNAL_URL=https://vpn.example.edu/jsxsd/

# 健康检查路径
HEALTH_PATH=/health

# 可信代理 CIDR，例如 Nginx 所在地址
# 使用本机 Nginx 时取消下一行注释；仅信任实际代理，不要填入校园网段
# TRUSTED_PROXIES=127.0.0.1/32

# IP 白名单热重载间隔，0 表示关闭
RELOAD_INTERVAL=5m

# 请求/上游检测超时
REQUEST_TIMEOUT=5s

# 健康端点是否检测上游；开启后任一上游失败返回 HTTP 503
CHECK_UPSTREAM=false

# JSON 格式日志
LOG_JSON=false
