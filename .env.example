# Optional JSON configuration. CLI > environment > JSON > defaults.
# CONFIG_FILE=/etc/jwc-302/config.json

# Local bind address; terminate HTTPS at your reverse proxy.
LISTEN_ADDR=127.0.0.1:8080

# Environment/CLI paths are relative to the process working directory.
# Paths explicitly set inside JSON are relative to the JSON file directory.
IPRANGE_FILE=iprange.txt
# Optional VPN, guest, or other pools that must always use the external entry.
EXCLUDE_IPRANGE_FILE=

# Replace these example endpoints before deployment.
INTERNAL_URL=https://internal.example.edu/jsxsd/
EXTERNAL_URL=https://vpn.example.edu/jsxsd/

HEALTH_PATH=/health
READY_PATH=/ready
# Set to /metrics to enable Prometheus metrics on the same listener.
METRICS_PATH=
UPSTREAM_CACHE_TTL=5s

# Trust only the immediate proxy and any known upstream proxies.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Both CIDR files are reread as one snapshot; 0 disables scheduled reloads.
RELOAD_INTERVAL=5m
REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

# 302 for navigation; 307 preserves request method/body on client redirects.
REDIRECT_CODE=302

# Compatibility option: probe upstreams on BOTH health and ready requests.
CHECK_UPSTREAM=false
# Preferred for load balancers: probe upstreams only on the ready endpoint.
READY_CHECK_UPSTREAM=false

LOG_JSON=false
# Keep false to avoid recording tickets and other query parameters.
LOG_QUERY=false
