[Unit]
Description=Configurable campus redirect gateway
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/jwc-302
EnvironmentFile=-/etc/jwc-302/environment
ExecStartPre=/opt/jwc-302/jwc-302 -config=/etc/jwc-302/config.json -check-config
ExecStart=/opt/jwc-302/jwc-302 -config=/etc/jwc-302/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=20s
KillSignal=SIGTERM

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
